<Window x:Class="RevCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RevCraft"
        mc:Ignorable="d"
        Title="파일 버전 체인 관리자"
        Height="720" Width="900"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 버튼 스타일 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 영역 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="파일 버전 체인 관리자" 
                           FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="파일을 열어 이전 버전들의 위치 이동/삭제 이력을 추적하고 다음 버전을 생성합니다." 
                           FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 윈도우 탐색기 우클릭 메뉴 등록 버튼 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="BtnToggleShellMenu" 
                        Content="⚙ 탐색기 우클릭 메뉴 등록" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnToggleShellMenu_Click"/>
            </StackPanel>
        </Grid>

        <!-- 파일 열기 & 드롭 영역 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14" Background="#F1F5F9" BorderBrush="#CBD5E1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnSelectFile" 
                        Content="📁 파일 열기 / 선택..." 
                        Style="{StaticResource ActionButtonStyle}"
                        Click="BtnSelectFile_Click"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="여기에 파일을 끌어다 놓거나 선택하세요 (자동 생성 없이 이력 열기만 수행)" 
                               FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text="탐색기 우클릭 '파일이력 확인하기'를 통해서도 이 창에서 즉시 이력을 확인할 수 있습니다." 
                               FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 중앙 콘텐츠 영역: 현재 파일 정보 + 이전 버전 체인 목록 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. 현재 열린 파일 정보 카드 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" x:Name="PanelFileInfoCard" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="4" Background="#E0E7FF" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="현재 열린 파일" FontWeight="Bold" Foreground="#3730A3" FontSize="11"/>
                            </Border>
                            <TextBlock x:Name="TxtCurrentFileName" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- 사용자가 원할 때 명시적으로 다음 버전 생성 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCreateNextVersion" 
                                    Content="⚡ 다음 버전 생성하기" 
                                    Style="{StaticResource SuccessButtonStyle}" 
                                    Margin="0,0,8,0"
                                    Click="BtnCreateNextVersion_Click"/>
                            <Button Content="📂 폴더 열기" 
                                    Style="{StaticResource SecondaryButtonStyle}" 
                                    Click="BtnOpenCurrentFolder_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 파일 경로 -->
                    <TextBox x:Name="TxtCurrentFilePath" IsReadOnly="True" Background="#F8FAFC" 
                             BorderBrush="#E2E8F0" Padding="6,4" FontSize="11" FontFamily="Consolas" Margin="0,0,0,8">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="⚡ 이 파일의 다음 버전 생성하기" Click="BtnCreateNextVersion_Click"/>
                                <MenuItem Header="📂 폴더 열고 파일 선택" Click="BtnOpenCurrentFolder_Click"/>
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>

                    <!-- 메타 정보 및 마지막 생성 알림 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="크기: " FontSize="11" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtCurrentFileSize" Text="0 bytes" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text=" | 수정일: " FontSize="11" Foreground="#64748B" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TxtCurrentFileDate" Text="-" FontSize="11" Foreground="#0F172A"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtActionNotice" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 이전 버전 체인 목록 카드 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 이전 버전 파일 히스토리" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock x:Name="TxtHistoryCount" Text=" (바이너리 트레일러 추적)" FontSize="12" Foreground="#64748B" Margin="6,2,0,0"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" 
                                   Text="💡 항목을 클릭하면 해당 폴더가 열리며 파일이 선택됩니다." FontSize="11" Foreground="#94A3B8"/>
                    </Grid>

                    <!-- 빈 상태 안내 -->
                    <Border x:Name="EmptyHistoryBorder" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtEmptyNotice" Text="파일을 선택하면 바이너리 트레일러에 기록된 이전 버전 체인을 추적하여 표시합니다." 
                                       FontSize="13" Foreground="#94A3B8" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 히스토리 ListView -->
                    <ListView x:Name="ListHistory" Grid.Row="1" Visibility="Collapsed" 
                              BorderThickness="1" BorderBrush="#E2E8F0" Background="#FAFAFA"
                              SelectionMode="Single"
                              SelectionChanged="ListHistory_SelectionChanged"
                              MouseDoubleClick="ListHistory_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📂 해당 폴더 열기 &amp; 파일 선택" Click="MenuHistoryOpenFolder_Click"/>
                                <MenuItem Header="⚡ 이 파일의 다음 버전 생성하기" Click="MenuHistoryCreateNext_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="단계" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayVersion}" FontWeight="SemiBold" Foreground="#1D4ED8" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="파일명" Width="220">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="상태" Width="105">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Moved">
                                                                <Setter Property="Foreground" Value="#2563EB"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Deleted">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="현재 위치 경로" Width="430">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentPath}" Foreground="#334155" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단 상태 바 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtFooterStatus" Text="준비 완료" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
        </Grid>
    </Grid>
</Window>

